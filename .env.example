# LLM for grounded extraction (any OpenAI-compatible chat-completions endpoint).
# Leave empty to run deterministic extraction only.
LLM_BASE_URL=https://ollama.com/v1
LLM_API_KEY=
LLM_MODEL=beam:cloud

# Where LLM responses are cached (default: ~/.job-scout/llm_cache).
# JOB_SCOUT_LLM_CACHE_DIR=

# Local embedding server for semantic skew (llama-server --embeddings).
EMBED_BASE_URL=http://127.0.0.1:8091/v1
